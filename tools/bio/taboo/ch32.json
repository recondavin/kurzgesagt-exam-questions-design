[
  { "term": "Pathogen",
    "ban": ["disease", "germ", "infection"],
    "ideas": [
      { "a": "It makes you ill: it causes harm in its host", "k": [{ "w": ["ill"], "n": 1 }, { "w": ["illness"], "n": 1 }, { "w": ["sick"], "n": 1 }, { "w": ["unwell"], "n": 1 }, { "w": ["harmful"], "n": 1 }, { "w": ["symptom"], "n": 1 }] },
      { "a": "It can be a virus, bacterium, fungus, protist, prion or parasitic animal", "k": [{ "w": ["virus"], "n": 1 }, { "w": ["bacteri"], "n": 1 }, { "w": ["fung"], "n": 1 }, { "w": ["protist"], "n": 1 }, { "w": ["prion"], "n": 1 }, { "w": ["parasit"], "n": 1 }, { "w": ["worm"], "n": 1 }] },
      { "a": "It gets into the body and can be caught from, or passed to, others", "k": [{ "w": ["catch"], "n": 1 }, { "w": ["caught"], "n": 1 }, { "w": ["contagious"], "n": 1 }, { "w": ["spread", "person"], "n": 2 }, { "w": ["spread", "people"], "n": 2 }, { "w": ["invad"], "n": 1 }, { "w": ["get", "into", "body"], "n": 3 }] }
    ],
    "need": 2,
    "model": "Any organism or agent, such as a bacterium, virus or fungus, that gets into your body and makes you ill." },

  { "term": "Virus",
    "ban": ["dna", "rna", "host", "parasite"],
    "ideas": [
      { "a": "Just nucleic acid (DNA or RNA) inside a protein coat", "k": [{ "w": ["nucleic"], "n": 1 }, { "w": ["protein", "coat"], "n": 2 }, { "w": ["capsid"], "n": 1 }, { "w": ["genetic", "coat"], "n": 2 }, { "w": ["gene", "coat"], "n": 2 }] },
      { "a": "It can only reproduce inside a living cell (an obligate parasite)", "k": [{ "w": ["only", "reproduc"], "n": 2 }, { "w": ["only", "multipl"], "n": 2 }, { "w": ["only", "replicat"], "n": 2 }, { "w": ["cannot", "reproduc", "own"], "n": 3 }, { "w": ["inside", "living", "cell"], "n": 3 }, { "w": ["obligat"], "n": 1 }] },
      { "a": "It is not made of cells, so it is hard to call it living", "k": [{ "w": ["not", "cell"], "n": 2 }, { "w": ["no", "cell"], "n": 2 }, { "w": ["non", "cellular"], "n": 2 }, { "w": ["not", "living"], "n": 2 }, { "w": ["non", "living"], "n": 2 }, { "w": ["nonliving"], "n": 1 }, { "w": ["no", "cytoplasm"], "n": 2 }] },
      { "a": "Examples: flu, HIV, measles, the common cold, COVID-19", "k": [{ "w": ["flu"], "n": 1 }, { "w": ["influenza"], "n": 1 }, { "w": ["hiv"], "n": 1 }, { "w": ["measl"], "n": 1 }, { "w": ["covid"], "n": 1 }, { "w": ["common", "cold"], "n": 2 }, { "w": ["herpes"], "n": 1 }] }
    ],
    "need": 2,
    "model": "Not a cell at all, just genes (nucleic acid) in a protein coat. It can only multiply inside a living cell. Flu and HIV are examples." },

  { "term": "Antigen",
    "ban": ["antibody", "foreign", "protein", "molecule"],
    "ideas": [
      { "a": "It doesn't belong to your body (non-self): it is on an invader", "k": [{ "w": ["not", "self"], "n": 2 }, { "w": ["non", "self"], "n": 2 }, { "w": ["nonself"], "n": 1 }, { "w": ["not", "belong"], "n": 2 }, { "w": ["dont", "belong"], "n": 2 }, { "w": ["invad"], "n": 1 }, { "w": ["intruder"], "n": 1 }, { "w": ["alien"], "n": 1 }] },
      { "a": "It triggers the body to make the matching antibodies", "k": [{ "w": ["trigger"], "n": 1 }, { "w": ["stimulat"], "n": 1 }, { "w": ["provok"], "n": 1 }, { "w": ["set", "off"], "n": 2 }, { "w": ["caus", "make"], "n": 2 }, { "w": ["make", "against"], "n": 2 }] },
      { "a": "It is a marker that white blood cells recognise", "k": [{ "w": ["recognis"], "n": 1 }, { "w": ["identif"], "n": 1 }, { "w": ["detect"], "n": 1 }, { "w": ["marker"], "n": 1 }, { "w": ["tag"], "n": 1 }, { "w": ["label"], "n": 1 }, { "w": ["flag"], "n": 1 }, { "w": ["spike"], "n": 1 }] }
    ],
    "need": 2,
    "model": "A chemical marker on an invading organism that your body sees as not self, so it triggers lymphocytes to make Y-shaped defenders that fit it." },

  { "term": "Antibody",
    "ban": ["antigen", "protein", "lymphocyte"],
    "ideas": [
      { "a": "Made by B lymphocytes (white blood cells)", "k": [{ "w": ["b", "cell"], "n": 2 }, { "w": ["b", "make"], "n": 2 }, { "w": ["white", "blood"], "n": 2 }, { "w": ["white", "cell"], "n": 2 }, { "w": ["plasma"], "n": 1 }] },
      { "a": "Each one locks onto one particular antigen only", "k": [{ "w": ["lock"], "n": 1 }, { "w": ["bind"], "n": 1 }, { "w": ["latch"], "n": 1 }, { "w": ["grab"], "n": 1 }, { "w": ["attach", "specific"], "n": 2 }, { "w": ["fit", "exact"], "n": 2 }, { "w": ["stick", "onto"], "n": 2 }] },
      { "a": "Y-shaped: it marks pathogens so they clump together and are destroyed", "k": [{ "w": ["y", "shape"], "n": 2 }, { "w": ["clump"], "n": 1 }, { "w": ["neutralis"], "n": 1 }, { "w": ["stick", "together"], "n": 2 }] }
    ],
    "need": 2,
    "model": "A Y-shaped molecule made by B cells. Each kind locks onto one exact target on a germ, so the germs clump together and get engulfed." },

  { "term": "B lymphocyte",
    "ban": ["antibody", "immune", "plasma"],
    "ideas": [
      { "a": "It makes antibodies: Y-shaped proteins that fit one antigen", "k": [{ "w": ["y", "shape"], "n": 2 }, { "w": ["protein", "antigen"], "n": 2 }, { "w": ["make", "protein"], "n": 2 }] },
      { "a": "Helper T cells switch it on, and then it multiplies", "k": [{ "w": ["helper", "t"], "n": 2 }, { "w": ["multipl"], "n": 1 }, { "w": ["divid"], "n": 1 }, { "w": ["clone"], "n": 1 }] },
      { "a": "Some of them stay on as memory cells", "k": [{ "w": ["memory"], "n": 1 }] },
      { "a": "Made in the bone marrow; part of the specific (adaptive) response", "k": [{ "w": ["bone", "marrow"], "n": 2 }, { "w": ["adaptive"], "n": 1 }, { "w": ["acquired"], "n": 1 }] }
    ],
    "need": 2,
    "model": "A defence cell from the bone marrow that, once a helper T cell switches it on, makes Y-shaped proteins to fit one antigen. Some become memory cells." },

  { "term": "Helper T cell",
    "ban": ["activate", "stimulate", "recognise"],
    "ideas": [
      { "a": "It identifies the antigen, often shown to it by a macrophage", "k": [{ "w": ["identif", "antigen"], "n": 2 }, { "w": ["detect", "antigen"], "n": 2 }, { "w": ["spot", "antigen"], "n": 2 }, { "w": ["show", "macrophage"], "n": 2 }, { "w": ["present", "macrophage"], "n": 2 }, { "w": ["macrophage", "antigen"], "n": 2 }] },
      { "a": "It switches on the B lymphocytes, so they make antibodies", "k": [{ "w": ["switch", "b"], "n": 2 }, { "w": ["turn", "b"], "n": 2 }, { "w": ["tell", "b"], "n": 2 }, { "w": ["signal", "b"], "n": 2 }, { "w": ["trigger", "b"], "n": 2 }, { "w": ["switch", "antibody"], "n": 2 }, { "w": ["turn", "antibody"], "n": 2 }, { "w": ["tell", "antibody"], "n": 2 }, { "w": ["signal", "antibody"], "n": 2 }, { "w": ["trigger", "antibody"], "n": 2 }] },
      { "a": "It switches on the killer T cells too", "k": [{ "w": ["switch", "killer"], "n": 2 }, { "w": ["turn", "killer"], "n": 2 }, { "w": ["tell", "killer"], "n": 2 }, { "w": ["signal", "killer"], "n": 2 }, { "w": ["trigger", "killer"], "n": 2 }] }
    ],
    "need": 2,
    "model": "A T lymphocyte that identifies the antigen a macrophage shows it, then switches on the B lymphocytes and the killer T lymphocytes." },

  { "term": "Killer T cell",
    "ban": ["destroy", "attack", "perforin"],
    "ideas": [
      { "a": "It targets the body's own cells that a virus has infected (and cancer cells)", "k": [{ "w": ["infect", "own"], "n": 2 }, { "w": ["infect", "body"], "n": 2 }, { "w": ["infect", "burst"], "n": 2 }, { "w": ["infect", "recognis"], "n": 2 }, { "w": ["infect", "target"], "n": 2 }, { "w": ["infect", "hunt"], "n": 2 }, { "w": ["cancer"], "n": 1 }, { "w": ["tumour"], "n": 1 }] },
      { "a": "It releases perforin, which punches holes in their membranes so they burst", "k": [{ "w": ["hole"], "n": 1 }, { "w": ["punch"], "n": 1 }, { "w": ["puncture"], "n": 1 }, { "w": ["pierc"], "n": 1 }, { "w": ["burst", "membrane"], "n": 2 }] },
      { "a": "Helper T cells switch it on; it is the cell-mediated part of the specific response", "k": [{ "w": ["helper", "t"], "n": 2 }, { "w": ["mediat"], "n": 1 }] }
    ],
    "need": 2,
    "model": "A T lymphocyte that targets parts of your own body infected by a virus, or cancerous, and punches holes in their membranes so they burst open." },

  { "term": "Suppressor T cell",
    "ban": ["stop", "switch", "off"],
    "ideas": [
      { "a": "It shuts down the immune response", "k": [{ "w": ["shut", "down"], "n": 2 }, { "w": ["wind", "down"], "n": 2 }, { "w": ["turn", "down"], "n": 2 }, { "w": ["calm"], "n": 1 }, { "w": ["halt"], "n": 1 }, { "w": ["inhibit"], "n": 1 }, { "w": ["dampen"], "n": 1 }, { "w": ["end", "response"], "n": 2 }, { "w": ["end", "attack"], "n": 2 }] },
      { "a": "It does this once the infection is over", "k": [{ "w": ["infect", "over"], "n": 2 }, { "w": ["infect", "gone"], "n": 2 }, { "w": ["infect", "finish"], "n": 2 }, { "w": ["infect", "clear"], "n": 2 }, { "w": ["infect", "beaten"], "n": 2 }, { "w": ["pathogen", "gone"], "n": 2 }, { "w": ["germ", "gone"], "n": 2 }] },
      { "a": "So it doesn't go too far and harm the body's own cells", "k": [{ "w": ["too", "far"], "n": 2 }, { "w": ["overreact"], "n": 1 }, { "w": ["autoimmun"], "n": 1 }, { "w": ["harm", "own"], "n": 2 }, { "w": ["damag", "own"], "n": 2 }] }
    ],
    "need": 2,
    "model": "A T lymphocyte that calms down and ends the immune response once the infection is over, so it doesn't go too far and damage your own tissues." },

  { "term": "Memory cell",
    "ban": ["remember", "second", "immune"],
    "ideas": [
      { "a": "It stays in the body for years after an infection", "k": [{ "w": ["year"], "n": 1 }, { "w": ["decade"], "n": 1 }, { "w": ["long", "time"], "n": 2 }, { "w": ["long", "term"], "n": 2 }, { "w": ["long", "last"], "n": 2 }, { "w": ["lifelong"], "n": 1 }, { "w": ["remain"], "n": 1 }] },
      { "a": "If the same pathogen comes back, it recognises it at once", "k": [{ "w": ["same", "back"], "n": 2 }, { "w": ["come", "back"], "n": 2 }, { "w": ["next", "time"], "n": 2 }, { "w": ["return"], "n": 1 }, { "w": ["reinfect"], "n": 1 }, { "w": ["recognis", "same"], "n": 2 }] },
      { "a": "So the response is much faster and bigger, and you don't get ill", "k": [{ "w": ["fast"], "n": 1 }, { "w": ["quick"], "n": 1 }, { "w": ["rapid"], "n": 1 }, { "w": ["immediat"], "n": 1 }, { "w": ["larg", "response"], "n": 2 }] },
      { "a": "Made from B and T lymphocytes during the first infection", "k": [{ "w": ["lymphocyte"], "n": 1 }, { "w": ["first", "infect"], "n": 2 }] }
    ],
    "need": 2,
    "model": "A lymphocyte that stays in your body for years after an infection, so if the same pathogen comes back the response is far faster." },

  { "term": "Macrophage",
    "ban": ["engulf", "phagocyte", "eat", "monocyte"],
    "ideas": [
      { "a": "It takes in pathogens by flowing around and surrounding them", "k": [{ "w": ["surround"], "n": 1 }, { "w": ["wrap"], "n": 1 }, { "w": ["swallow"], "n": 1 }, { "w": ["envelop"], "n": 1 }, { "w": ["gobbl"], "n": 1 }, { "w": ["devour"], "n": 1 }, { "w": ["pseudopod"], "n": 1 }] },
      { "a": "It digests them inside, with enzymes from lysosomes", "k": [{ "w": ["digest"], "n": 1 }, { "w": ["lysosome"], "n": 1 }, { "w": ["enzyme", "inside"], "n": 2 }] },
