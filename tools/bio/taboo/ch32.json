      { "a": "It shows the pathogen's antigens to lymphocytes (helper T cells)", "k": [{ "w": ["show", "antigen"], "n": 2 }, { "w": ["present", "antigen"], "n": 2 }, { "w": ["display", "antigen"], "n": 2 }, { "w": ["show", "lymphocyte"], "n": 2 }, { "w": ["show", "helper"], "n": 2 }] }
    ],
    "need": 2,
    "model": "A large white blood cell that surrounds any germ it finds, digests it with enzymes, and shows the germ's antigens to lymphocytes." },

  { "term": "Lysozyme",
    "ban": ["tears", "saliva", "enzyme"],
    "ideas": [
      { "a": "It is in tears, saliva and mucus", "k": [{ "w": ["eye"], "n": 1 }, { "w": ["spit"], "n": 1 }, { "w": ["mouth"], "n": 1 }, { "w": ["nose"], "n": 1 }, { "w": ["mucus"], "n": 1 }, { "w": ["cry"], "n": 1 }, { "w": ["sweat"], "n": 1 }] },
      { "a": "It breaks down the cell walls of bacteria, so they burst", "k": [{ "w": ["wall"], "n": 1 }, { "w": ["burst", "bacteri"], "n": 2 }, { "w": ["break", "down", "bacteri"], "n": 3 }] },
      { "a": "It is part of the general (innate) defence: it acts on any bacteria", "k": [{ "w": ["general", "defence"], "n": 2 }, { "w": ["innate"], "n": 1 }, { "w": ["non", "specific"], "n": 2 }, { "w": ["first", "line"], "n": 2 }, { "w": ["any", "bacteri"], "n": 2 }] }
    ],
    "need": 2,
    "model": "A chemical in the fluid from your eyes, in spit and in mucus, that breaks down the walls of bacteria so they burst. Part of the general defence." },

  { "term": "Vaccination",
    "ban": ["immune", "jab", "antibody"],
    "ideas": [
      { "a": "A harmless (dead or weakened) form of the pathogen, or just its antigens, is put into the body", "k": [{ "w": ["harmless"], "n": 1 }, { "w": ["dead"], "n": 1 }, { "w": ["weak"], "n": 1 }, { "w": ["inactiv"], "n": 1 }, { "w": ["not", "harmful"], "n": 2 }, { "w": ["antigen", "put"], "n": 2 }, { "w": ["antigen", "give"], "n": 2 }] },
      { "a": "The body makes its own antibodies and memory cells against it", "k": [{ "w": ["memory"], "n": 1 }, { "w": ["lymphocyte", "make"], "n": 2 }, { "w": ["white", "blood"], "n": 2 }, { "w": ["y", "shape"], "n": 2 }, { "w": ["own", "defence"], "n": 2 }, { "w": ["make", "defence"], "n": 2 }, { "w": ["learn", "fight"], "n": 2 }, { "w": ["learn", "recognis"], "n": 2 }] },
      { "a": "So you are protected before you ever meet the real pathogen, and it can't spread", "k": [{ "w": ["real", "pathogen"], "n": 2 }, { "w": ["real", "germ"], "n": 2 }, { "w": ["real", "virus"], "n": 2 }, { "w": ["real", "thing"], "n": 2 }, { "w": ["real", "one"], "n": 2 }, { "w": ["before", "catch"], "n": 2 }, { "w": ["never", "catch"], "n": 2 }, { "w": ["herd"], "n": 1 }, { "w": ["prevent", "spread"], "n": 2 }, { "w": ["protect", "before"], "n": 2 }, { "w": ["future"], "n": 1 }] }
    ],
    "need": 2,
    "model": "A harmless, dead or weakened form of a germ is put into you, so your white blood cells make defences and memory cells before you ever meet the real thing." },

  { "term": "Active immunity",
    "ban": ["own", "vaccine", "memory"],
    "ideas": [
      { "a": "Your own body (your own lymphocytes) makes the antibodies", "k": [{ "w": ["body", "make", "antibody"], "n": 3 }, { "w": ["itself"], "n": 1 }, { "w": ["lymphocyte", "make", "antibody"], "n": 3 }, { "w": ["b", "make", "antibody"], "n": 3 }] },
      { "a": "It lasts a long time, because memory cells are made", "k": [{ "w": ["long", "last"], "n": 2 }, { "w": ["long", "time"], "n": 2 }, { "w": ["long", "term"], "n": 2 }, { "w": ["year"], "n": 1 }, { "w": ["lifelong"], "n": 1 }, { "w": ["permanent"], "n": 1 }] },
      { "a": "You get it by catching the disease, or from a vaccine", "k": [{ "w": ["catch"], "n": 1 }, { "w": ["caught"], "n": 1 }, { "w": ["recover"], "n": 1 }, { "w": ["jab"], "n": 1 }, { "w": ["had", "disease"], "n": 2 }] }
    ],
    "need": 2,
    "model": "After you have had the disease, or a jab, your body makes the antibodies itself, so the protection lasts for years." },

  { "term": "Passive immunity",
    "ban": ["ready", "mother", "milk"],
    "ideas": [
      { "a": "You are given antibodies (e.g. an injection) made by another person or animal: your body doesn't make them", "k": [{ "w": ["give", "antibody"], "n": 2 }, { "w": ["receiv", "antibody"], "n": 2 }, { "w": ["antibody", "another"], "n": 2 }, { "w": ["antibody", "someone"], "n": 2 }, { "w": ["antibody", "inject"], "n": 2 }, { "w": ["antibody", "donat"], "n": 2 }, { "w": ["doesnt", "make"], "n": 2 }] },
      { "a": "e.g. a baby gets them through breastfeeding or the placenta, or you get antiserum", "k": [{ "w": ["breast"], "n": 1 }, { "w": ["placenta"], "n": 1 }, { "w": ["baby"], "n": 1 }, { "w": ["newborn"], "n": 1 }, { "w": ["serum"], "n": 1 }, { "w": ["antiserum"], "n": 1 }, { "w": ["antivenom"], "n": 1 }] },
      { "a": "It works at once but is short-lived: it fades within weeks (no memory cells)", "k": [{ "w": ["short"], "n": 1 }, { "w": ["fade"], "n": 1 }, { "w": ["week"], "n": 1 }, { "w": ["temporar"], "n": 1 }, { "w": ["wear", "off"], "n": 2 }, { "w": ["no", "memory"], "n": 2 }, { "w": ["immediat"], "n": 1 }] }
    ],
    "need": 2,
    "model": "You are given antibodies made by another body, e.g. by breastfeeding or an injection. It works at once but fades in weeks, as no memory cells form." },

  { "term": "Antibiotic",
    "ban": ["bacteria", "penicillin", "medicine"],
    "ideas": [
      { "a": "Made by a micro-organism, such as a fungus", "k": [{ "w": ["fung"], "n": 1 }, { "w": ["mould"], "n": 1 }, { "w": ["make", "microb"], "n": 2 }, { "w": ["make", "micro", "organism"], "n": 3 }] },
      { "a": "It kills bacteria or stops them growing", "k": [{ "w": ["stop", "grow"], "n": 2 }, { "w": ["kill", "microb"], "n": 2 }, { "w": ["destroy", "microb"], "n": 2 }, { "w": ["kill", "germ"], "n": 2 }, { "w": ["destroy", "germ"], "n": 2 }, { "w": ["kill", "micro", "organism"], "n": 3 }, { "w": ["destroy", "micro", "organism"], "n": 3 }] },
      { "a": "It has no effect on viruses", "k": [{ "w": ["no", "virus"], "n": 2 }, { "w": ["not", "virus"], "n": 2 }, { "w": ["doesnt", "virus"], "n": 2 }, { "w": ["cannot", "virus"], "n": 2 }, { "w": ["useless", "virus"], "n": 2 }, { "w": ["except", "virus"], "n": 2 }] }
    ],
    "need": 2,
    "model": "A substance made by a fungus or other microbe that destroys other microbes or stops them growing, but it has no effect on viruses." },

  { "term": "Antibiotic resistance",
    "ban": ["mutation", "natural", "immune"],
    "ideas": [
      { "a": "Bacteria are no longer killed by a drug that used to kill them", "k": [{ "w": ["no", "longer"], "n": 2 }, { "w": ["not", "kill"], "n": 2 }, { "w": ["arent", "kill"], "n": 2 }, { "w": ["isnt", "kill"], "n": 2 }, { "w": ["unaffect"], "n": 1 }, { "w": ["stop", "work"], "n": 2 }, { "w": ["doesnt", "work"], "n": 2 }] },
      { "a": "It starts with a random mutation in a gene (which can also pass to other bacteria on a plasmid)", "k": [{ "w": ["random"], "n": 1 }, { "w": ["gene", "chang"], "n": 2 }, { "w": ["plasmid"], "n": 1 }] },
      { "a": "Overuse or misuse kills the others, so the resistant ones survive and multiply (natural selection)", "k": [{ "w": ["misuse"], "n": 1 }, { "w": ["overuse", "drug"], "n": 2 }, { "w": ["overprescrib"], "n": 1 }, { "w": ["too", "often"], "n": 2 }, { "w": ["surviv", "multipl"], "n": 2 }, { "w": ["surviv", "reproduc"], "n": 2 }, { "w": ["surviv", "breed"], "n": 2 }, { "w": ["finish", "course"], "n": 2 }, { "w": ["select"], "n": 1 }] }
